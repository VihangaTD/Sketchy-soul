{
  "name": "sketchy-soul",
  "version": "1.0.0",
  "private": true,
  "description": "Sketchy Soul — hand-drawn portrait studio. Portfolio + commission ordering with online payment.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.mts",
    "db:seed:missing": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.mts --missing",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@vercel/blob": "^0.27.1",
    "google-auth-library": "^9.15.1",
    "next": "15.5.22",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "stripe": "^18.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
